<Project>

  <PropertyGroup Label="Central Package Management">
    <!-- Enable Central Package Management -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <PropertyGroup Label="Build Configuration - Common">
    <!-- Target Framework -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <PropertyGroup Label="Package Information">
    <!-- Version -->
    <!-- 0.12.0: AgentConfig.Tools(이름 목록) + IronhiveOptions.Tools(등록 풀) — 도구 호출
         (function calling)을 IronHive 백엔드에 노출. 이름이 풀에 없으면 에이전트 생성 시점에
         즉시 실패(조용한 무시 금지). ToolCallStartChunk/ToolCallCompleteChunk 스트리밍 표면
         활성화(정의만 있고 발행되지 않던 상태 해소).
         0.10.0: ProcessOptions/AgentRunOptions.ThinkingEffort 패스스루(중립 enum) —
         Ironhive 어댑터가 AgentInvokeOptions.ThinkingEffort로 매핑, 0.9.1의 ThinkingChunk
         어휘에 활성화 통로 제공(null=프레임워크 기본, None=명시적 비활성).
         0.9.1: IronhiveAdapter ThinkingDeltaContent→ThinkingChunk 매핑 (reasoning 표면 완성).
         0.9.0: IronHive 0.14.0 페어링 + 구조화 표면 신설 — ProcessOptions.Suggestions
         패스스루(중립 SuggestionRequest), IAgentOrchestrator/ILLMFrameworkAdapter의
         *StructuredAsync(AgentRunResult/StreamChunk), 텍스트 표면은 projection. -->
    <Version>0.14.6</Version>

    <!-- Authors and Company -->
    <Authors>iyulab</Authors>
    <Company>iyulab</Company>
    <Product>Ironbees</Product>
    <Copyright>Copyright (c) 2025 iyulab</Copyright>

    <!-- Repository and Project URLs -->
    <PackageProjectUrl>https://github.com/iyulab/ironbees</PackageProjectUrl>
    <RepositoryUrl>https://github.com/iyulab/ironbees</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- License -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!-- Release Notes -->
    <PackageReleaseNotes>See CHANGELOG.md for release notes</PackageReleaseNotes>

    <!-- Common Tags -->
    <PackageTagsBase>ai;agents;multi-agent;orchestration</PackageTagsBase>
  </PropertyGroup>

  <PropertyGroup Label="Build Configuration">
    <!-- Documentation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: missing XML doc comments -->
    <!-- NU1903 is deliberately NOT suppressed. A repo-wide suppression of a high-severity
         advisory blinds every project to future ones, and the reason this one carried
         ("no fix available" for a transitive dependency) had gone stale: the advisory it named
         no longer fires, while a *different* high-severity one did and was being hidden by it.
         Vulnerable dependencies are lifted to a patched version instead — see the version pins
         in Directory.Packages.props. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Package README -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Include README from repository root in all packages -->
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <PropertyGroup Condition="Exists('$(MSBuildThisFileDirectory)../../local-packages')">
    <RestoreAdditionalProjectSources>
      $(RestoreAdditionalProjectSources);$(MSBuildThisFileDirectory)../../local-packages
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

</Project>
