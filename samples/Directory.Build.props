<Project>

  <!-- Inherit the repo-root shared settings, then mark every sample non-packable.
       Samples are runnable demos, not shipped NuGet packages; without this they were
       packed into output (polluting local feeds and failing NU5104 on prerelease
       dependencies). -->
  <Import Project="../Directory.Build.props" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
