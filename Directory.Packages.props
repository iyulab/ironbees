<Project>
  <PropertyGroup>
    <!-- Optional: Enforce version consistency across all projects -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="Core Framework Dependencies">
    <!-- Microsoft Extensions Core -->
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.9.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.9.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.9.0" />
    <!-- Microsoft Extensions DI and Logging -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
    <!-- Microsoft Extensions Configuration -->
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
    <!-- Security lift: 3.5.3 carries a high-severity advisory (GHSA-v5pm-xwqc-g5wc).
         3.5.5 is the lowest release on the same minor that clears it. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="3.5.5" />
  </ItemGroup>
  <ItemGroup Label="IronHive">
    <PackageVersion Include="IronHive.Abstractions" Version="0.30.0" />
    <PackageVersion Include="IronHive.Core" Version="0.30.0" />
  </ItemGroup>
  <ItemGroup Label="AI and Agent Framework">
    <!-- Azure AI Services -->
    <PackageVersion Include="Azure.AI.ContentSafety" Version="1.0.0" />
    <PackageVersion Include="Azure.AI.OpenAI" Version="2.9.0-beta.1" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <!-- OpenTelemetry: pin transitive to avoid NU1902 vulnerability in 1.15.0 -->
    <!-- Microsoft Agents -->
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.19.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Abstractions" Version="1.19.0" />
    <PackageVersion Include="Microsoft.Agents.AI.OpenAI" Version="1.19.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Workflows" Version="1.19.0" />
    <!-- OpenAI SDK -->
    <PackageVersion Include="OpenAI" Version="2.12.0" />
  </ItemGroup>
  <ItemGroup Label="Development Tools">
    <!-- Roslyn and Code Analysis -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
    <PackageVersion Include="Microsoft.Build.Locator" Version="1.11.2" />
    <!-- Utilities -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <!-- Pinned to 1.24.4, matching modules/lm-supply and flux/FluxGuard's intentional floor
         (DirectML LayerNormalization crash on 1.25+, docket iyulab/FluxGuard#156). This project
         only calls the plain `new InferenceSession(path)` constructor (OnnxEmbeddingProvider.cs),
         so nothing here needs 1.25/1.26; re-pinning down avoids re-creating the same
         cross-submodule contradiction that NuGet's higher-floor-wins resolution silently papered over. -->
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
    <PackageVersion Include="DotNetEnv" Version="3.2.0" />
    <!-- Resilience and Caching -->
    <PackageVersion Include="Polly" Version="8.6.6" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.12" />
    <!-- Token Counting and Cost Tracking -->
    <PackageVersion Include="TokenMeter" Version="0.7.5" />
  </ItemGroup>
  <ItemGroup Label="Web and API">
    <!-- ASP.NET Core -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.2" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.1.7" />
  </ItemGroup>
  <ItemGroup Label="Testing">
    <!-- xUnit v3/MTP native mode: no Microsoft.NET.Test.Sdk needed, coverlet.collector was a dead
         reference (CI never invoked the coverage collector flag) -->
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.HangDump" Version="2.3.3" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.3.3" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
      <!-- Convention checks (options reachability) — iyulab conventions kit -->
    <PackageVersion Include="Iyu.Conventions.Testing" Version="0.1.0" />
  </ItemGroup>
</Project>