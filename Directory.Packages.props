<Project>
  <PropertyGroup>
    <!-- Optional: Enforce version consistency across all projects -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="Core Framework Dependencies">
    <!-- Microsoft Extensions Core -->
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.11.0" />
    <!-- Microsoft Extensions DI and Logging -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.13" />
    <!-- Microsoft Extensions Configuration -->
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />
    <!-- Security lift: 3.5.3 carries a high-severity advisory (GHSA-v5pm-xwqc-g5wc).
         3.5.5 is the lowest release on the same minor that clears it. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="3.11.0" />
  </ItemGroup>
  <ItemGroup Label="IronHive">
    <PackageVersion Include="IronHive.Abstractions" Version="0.70.0" />
    <PackageVersion Include="IronHive.Core" Version="0.70.0" />
    <PackageVersion Include="IronHive.Extensions.AI" Version="0.70.0" />
    <!-- Test-only: the README's and docs' provider examples compile against these -->
    <PackageVersion Include="IronHive.Providers.Anthropic" Version="0.70.0" />
    <PackageVersion Include="IronHive.Providers.GoogleAI" Version="0.70.0" />
    <PackageVersion Include="IronHive.Providers.OpenAI" Version="0.70.0" />
    <PackageVersion Include="IronHive.Providers.OpenAI.Compatible" Version="0.70.0" />
  </ItemGroup>
  <ItemGroup Label="AI Services">
    <!-- Azure AI Services -->
    <PackageVersion Include="Azure.AI.ContentSafety" Version="1.0.0" />
    <!-- OpenAI SDK -->
    <PackageVersion Include="OpenAI" Version="2.14.0" />
  </ItemGroup>
  <ItemGroup Label="Development Tools">
    <!-- Roslyn and Code Analysis -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
    <PackageVersion Include="Microsoft.Build.Locator" Version="1.11.2" />
    <!-- Utilities -->
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <!-- This project only calls the plain `new InferenceSession(path)` constructor
         (OnnxEmbeddingProvider.cs), so its ORT floor should track what the other ORT packages in a
         consumer's graph need rather than run ahead of them: NuGet's highest-floor-wins resolution
         makes the highest floor the effective one for every consumer. -->
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.31.0" />
    <PackageVersion Include="DotNetEnv" Version="3.2.0" />
    <!-- Resilience and Caching -->
    <PackageVersion Include="Polly" Version="8.8.0" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.13" />
    <!-- Token Counting and Cost Tracking -->
    <PackageVersion Include="TokenMeter" Version="0.15.0" />
  </ItemGroup>
  <ItemGroup Label="Web and API">
    <!-- ASP.NET Core -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.3.1" />
  </ItemGroup>
  <ItemGroup Label="Testing">
    <!-- xUnit v3/MTP native mode: no Microsoft.NET.Test.Sdk needed, coverlet.collector was a dead
         reference (CI never invoked the coverage collector flag) -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.HangDump" Version="2.5.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.1" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
      <!-- Convention checks (options reachability) — iyulab conventions kit -->
    <PackageVersion Include="Iyu.Conventions.Testing" Version="0.13.0" />
    <PackageVersion Include="Iyu.Conventions.Testing.Snippets" Version="0.13.0" />
  </ItemGroup>
</Project>