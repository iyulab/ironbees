<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Package-specific Metadata -->
    <Description>Abstract autonomous execution SDK for goal-based iterative task orchestration with oracle verification. Framework-agnostic design supporting any task executor and LLM-based oracle.</Description>
    <PackageTags>$(PackageTagsBase);autonomous;orchestration;oracle;goal-based;iterative</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="YamlDotNet" />
    <!-- Token Counting -->
    <PackageReference Include="TokenMeter" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared source, not a reference: this SDK does not depend on Ironbees.Core. -->
    <Compile Include="..\Ironbees.Core\Yaml\YamlUnknownKeys.cs" Link="Yaml\YamlUnknownKeys.cs" />
  </ItemGroup>

</Project>
